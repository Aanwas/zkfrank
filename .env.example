# Copy to .env and fill in. The scripts read these; a missing one throws
# immediately rather than falling back to a default that would fail later and
# less clearly.
#
# Run with: node --env-file=.env scripts/issue_card.mjs 1001

# The Pi wired to the NFC reader, as user@host. The PC reaches it over SSH and
# asks for one of two actions, 'read' or 'write'. Which script runs is decided
# on the Pi by backend/pi_agent.sh, not here - nothing from this side is ever
# interpolated into a command there.
ZKFRANK_PI_HOST=

# SSH port on the Pi. Not necessarily 22.
ZKFRANK_PI_PORT=

# Optional: port for the visualiser in frontend/server.mjs. Defaults to 4173.
# It binds to 127.0.0.1 regardless, so it is never reachable from the network.
ZKFRANK_UI_PORT=
