# Copy to .env and fill in. Both scripts/validate_demo.mjs and the SSH pull it
# performs read these; a missing one throws immediately rather than falling back
# to a default that would fail later and less clearly.
#
# Run with: node --env-file=.env scripts/validate_demo.mjs

# The Pi running nfc_reader.py, as user@host. It is the only machine wired to
# the NFC reader; the PC pulls from it over SSH.
ZKFRANK_PI_HOST=

# SSH port on the Pi. Not necessarily 22.
ZKFRANK_PI_PORT=

# Path to nfc_reader.py on the Pi, as the SSH login shell sees it.
ZKFRANK_PI_SCRIPT=
