// Pins down the byte-level handshake between the college issuer (Node) and the
// contract (Noir) before either side is built on top of it.
//
// The issuer signs with createSign('SHA256'), which hashes the message itself
// and signs the digest. verify_signature below does no hashing at all - it takes
// the digest as an argument. So the two sides only agree if Noir hashes exactly
// the bytes Node hashed. Get that wrong and the only symptom is a false return
// value, identical to a forged signature.
//
// These tests need no TXE environment: they are pure arithmetic over a fixture.

// Fixture generated by scripts/ecdsa_fixture.mjs - do not edit by hand.
// Signed value: 123456789

global VALUE: Field = 123456789;

global PUBLIC_KEY_X: [u8; 32] = [
    171, 76, 14, 40, 71, 57, 104, 219, 143, 103, 142, 36,
    172, 0, 78, 71, 202, 57, 52, 191, 22, 27, 237, 201,
    114, 199, 121, 0, 225, 160, 197, 109,
];

global PUBLIC_KEY_Y: [u8; 32] = [
    251, 169, 227, 124, 64, 22, 179, 134, 206, 142, 192, 231,
    104, 169, 46, 8, 58, 239, 139, 162, 93, 134, 45, 16,
    138, 100, 153, 252, 195, 183, 191, 118,
];

global SIGNATURE: [u8; 64] = [
    221, 228, 78, 11, 152, 190, 168, 246, 173, 132, 31, 72,
    81, 134, 164, 150, 201, 200, 186, 0, 103, 169, 155, 65,
    213, 161, 13, 103, 56, 146, 81, 181, 110, 184, 135, 250,
    199, 170, 10, 210, 179, 197, 74, 195, 13, 238, 123, 137,
    235, 174, 34, 75, 140, 62, 225, 75, 78, 243, 119, 189,
    226, 121, 6, 188,
];

/// Checks the fixture signature against `value`, exactly the way the contract
/// will check the college signature against a commitment.
fn verify(value: Field) -> bool {
    // The annotation on the left is what fixes the width at 32 bytes.
    let value_bytes: [u8; 32] = value.to_be_bytes();

    // Node hashed these same bytes inside createSign('SHA256'); verify_signature
    // does no hashing of its own, so the digest has to be handed to it ready.
    let message_hash: [u8; 32] = sha256::digest(value_bytes);

    std::ecdsa_secp256r1::verify_signature(
        PUBLIC_KEY_X,
        PUBLIC_KEY_Y,
        SIGNATURE,
        message_hash,
    )
}

#[test]
fn the_college_signature_verifies() {
    assert(verify(VALUE), "fixture signature should verify");
}

#[test]
fn a_signature_over_a_different_value_is_rejected() {
    // Same signature, same key, one different byte in the message. This is what
    // a student swapping in someone else's commitment would look like.
    assert(!verify(VALUE + 1), "signature must not verify against another value");
}
